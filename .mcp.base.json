{
  "mcpServers": {
    "MCP_DOCKER": {
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run"
      ],
      "env": {
        "LOCALAPPDATA": "C:\\Users\\Admin\\AppData\\Local",
        "ProgramData": "C:\\ProgramData",
        "ProgramFiles": "C:\\Program Files"
      },
      "type": "stdio"
    },
    "github": {
      "command": "bash",
      "args": [
        ".claude/hooks/github-mcp-server.sh"
      ],
      "type": "stdio"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com",
      "headers": {
        "Authorization": "Bearer ${VERCEL_TOKEN_FULL}"
      }
    },
    "doppler": {
      "command": "npx",
      "args": [
        "-y",
        "@dopplerhq/mcp-server"
      ],
      "type": "stdio"
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "gmail": {
      "command": "npx",
      "args": [
        "-y",
        "@gongrzhe/server-gmail-autoauth-mcp"
      ],
      "type": "stdio"
    },
    "filesystem": {
      "command": "/mnt/c/Program Files/nodejs/node.exe",
      "args": [
        "C:\\Program Files\\nodejs\\node_modules\\npm\\bin\\npx-cli.js",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:\\Photoshop-work",
        "D:\\Blender-work",
        "D:\\Google Drive\\newhazetek@gmail.com"
      ],
      "type": "stdio"
    }
  }
}
