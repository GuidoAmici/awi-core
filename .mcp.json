{
  "mcpServers": {
    "MCP_DOCKER": {
      "command": "docker",
      "args": ["mcp", "gateway", "run"],
      "env": {
        "LOCALAPPDATA": "C:\\Users\\Admin\\AppData\\Local",
        "ProgramData": "C:\\ProgramData",
        "ProgramFiles": "C:\\Program Files"
      },
      "type": "stdio"
    },
    "meta-ads": {
      "command": "powershell.exe",
      "args": ["-Command", "meta-ads-mcp"],
      "type": "stdio"
    },
    "sketchup": {
      "command": "powershell.exe",
      "args": ["-Command", "uvx --with mcp==1.3.0 sketchup-mcp"],
      "type": "stdio"
    },
    "blender": {
      "command": "powershell.exe",
      "args": ["-Command", "uvx mcp-for-blender --port 9877"],
      "type": "stdio"
    },
    "blender-3": {
      "command": "powershell.exe",
      "args": ["-Command", "uvx mcp-for-blender --port 9879"],
      "type": "stdio"
    },
    "github": {
      "command": "bash",
      "args": [".claude/hooks/github-mcp-server.sh"],
      "type": "stdio"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com",
      "headers": {
        "Authorization": "Bearer ${VERCEL_TOKEN_FULL}"
      }
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server-supabase@latest", "--access-token", "${AFIN_SUPABASE_PAT}"],
      "type": "stdio"
    },
    "doppler": {
      "command": "npx",
      "args": ["-y", "@dopplerhq/mcp-server"],
      "type": "stdio"
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "mercadopago": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.mercadopago.com/mcp", "18999"],
      "type": "stdio"
    },
    "arca-afip": {
      "command": "npx",
      "args": ["-y", "mcp-arca-afip"],
      "type": "stdio"
    },
    "gmail": {
      "command": "npx",
      "args": ["-y", "@gongrzhe/server-gmail-autoauth-mcp"],
      "type": "stdio"
    },
    "photoshop-alis": {
      "command": "/mnt/c/Program Files/nodejs/node.exe",
      "args": [
        "C:\\Program Files\\nodejs\\node_modules\\npm\\bin\\npx-cli.js",
        "-y",
        "@alisaitteke/photoshop-mcp"
      ],
      "env": {
        "LOG_LEVEL": "1"
      },
      "type": "stdio"
    },
    "filesystem": {
      "command": "/mnt/c/Program Files/nodejs/node.exe",
      "args": [
        "C:\\Program Files\\nodejs\\node_modules\\npm\\bin\\npx-cli.js",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:\\Photoshop-work",
        "D:\\Blender-work"
      ],
      "type": "stdio"
    }
  }
}