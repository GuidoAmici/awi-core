        "^CONTEXT\\.md$"
      ],
      "excepto_contenido": "(?i)(?:\\b(?:no|not|nada|ning[uú]n[ao]?|nunca|never|nothing|neither)\\b|\\bya no\\b|\\bdej[oó] de\\b|\\bse elimin|\\beliminad[oa]|\\bresuelto\\b|\\bdeleted\\b|\\bremoved\\b|\\bgone\\b|\\breemplaz|\\bobsolet|\\bplain clones?\\b)"
