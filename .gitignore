# Obsidian
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/
.obsidian/core-plugins-migration.json

# macOS
.DS_Store

# Temporary files
*.tmp

# Instance data — private to each operator, never leaves the machine. Holds user
# profiles and the org workspaces, each a separate cloned repo. Ignoring it is a
# correctness requirement: without this, `git add -A` swallows the children as
# embedded repos. See ADR 0011 on what .gitignore is and isn't for.
_data/

# Python cache
**/__pycache__/
*.pyc

# Apps workspace
apps/package-lock.json

# Claude local settings — machine-specific, not committed
.claude/settings.local.json

# Nothing generates or reads .gitmodules since ADR 0009 — nothing here is a
# submodule, and the generator that used to write this file is gone. Kept as a
# guard: a stray .gitmodules would be a bug to notice, not config to commit.
.gitmodules

# Cloned repo declared in user-submodules.json, not a submodule (ADR 0009).
# Ignored for the same correctness reason as _data/, not because of gitlinks —
# there are none left anywhere.
_system/agency-agents/

# Supabase CLI temp files (contain project ref and connection URLs)
supabase/

# Agent scratch — delegate logs and prompts, throwaway scripts. The directory
# exists at runtime (delegate_run.py and check-delegates.sh use
# .claude/tmp/delegates/inbox.md) but is never versioned: this is how 105 files
# of scratch, including plaintext credentials, ended up in a public repo.
# See ADR 0014.
.claude/tmp/

# Test runner scratch
test-results/
