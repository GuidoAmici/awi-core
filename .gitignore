# Obsidian
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/
.obsidian/core-plugins-migration.json

# macOS
.DS_Store

# Temporary files
*.tmp

# Instance data — private to each AWI instance, never mirrored to awi-core.
# Holds user profiles, org workspaces and their submodules. Source of truth for
# .gitmodules generation (current-user.json + user-submodules.json).
_data/

# Python cache
**/__pycache__/
*.pyc

# Apps workspace
apps/package-lock.json

# Claude local settings — machine-specific, not committed
.claude/settings.local.json

# Generated per-user from _data/users/*/user-submodules.json — never committed.
# See ADR 0001 and .claude/skills/shared/scripts/generate_gitmodules.py
.gitmodules

# Submodules declared in user-submodules.json and materialised by /awi-initialize.
# Their gitlinks are not versioned either — see ADR 0001.
_system/agency-agents/

# Public sync — local machine path, never committed
.claude/config/public-repo-path

# Supabase CLI temp files (contain project ref and connection URLs)
supabase/
